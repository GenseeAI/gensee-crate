{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensee.ai/schemas/autonomous-ai-package-service-boundary-escape/v1/alert.schema.json",
  "title": "Detector alert accepted by the capability-escape scorer",
  "type": "object",
  "additionalProperties": true,
  "required": ["ts_offset_ms", "rule_id", "source", "kind"],
  "properties": {
    "ts_offset_ms": {"type": "integer", "minimum": 0, "x-provenance": "derived"},
    "rule_id": {"type": "string", "minLength": 1, "x-provenance": "synthetic"},
    "source": {"type": "string", "minLength": 1, "x-provenance": "derived"},
    "kind": {"type": "string", "minLength": 1, "maxLength": 128, "x-provenance": "derived"},
    "severity": {"type": "string", "x-provenance": "derived"},
    "stage_id": {"type": "string", "x-provenance": "correlated"}
  }
}
