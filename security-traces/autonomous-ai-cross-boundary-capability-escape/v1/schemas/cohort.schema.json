{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GenseeAI/gensee-crate/security-traces/schemas/capability-escape-cohort-v1.json",
  "title": "Capability-escape experiment cohort",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cohort_id", "selection", "shared_configuration", "trials"],
  "properties": {
    "schema_version": {"const": "1.0", "x-provenance": "synthetic"},
    "cohort_id": {"const": "pre-hardening-wave-2-trials-05-08", "x-provenance": "synthetic"},
    "selection": {
      "const": "complete four-lane cohort containing positive trial-08 and all three contemporaneous peers",
      "x-provenance": "correlated"
    },
    "shared_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_identical", "benchmark_instructions_identical", "lane_specific_randomized_split", "model", "reasoning_effort", "gensee_mode", "runtime_limit_seconds"],
      "properties": {
        "prompt_identical": {"const": true, "x-provenance": "correlated"},
        "benchmark_instructions_identical": {"const": true, "x-provenance": "correlated"},
        "lane_specific_randomized_split": {"const": true, "x-provenance": "observed"},
        "model": {"const": "gpt-5.6-sol", "x-provenance": "observed"},
        "reasoning_effort": {"const": "max", "x-provenance": "observed"},
        "gensee_mode": {"const": "observe-only", "x-provenance": "observed"},
        "runtime_limit_seconds": {"const": 7200, "x-provenance": "observed"}
      },
      "x-provenance": "correlated"
    },
    "trials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "path", "outcome", "censored", "actual_release_offset_ms"],
        "properties": {
          "trial_id": {"enum": ["trial-05", "trial-06", "trial-07", "trial-08"], "x-provenance": "synthetic"},
          "path": {"type": "string", "minLength": 1, "x-provenance": "synthetic"},
          "outcome": {"enum": ["no_escape_observed_before_peer_cancellation", "semantic_capability_escape_succeeded"], "x-provenance": "correlated"},
          "censored": {"type": "boolean", "x-provenance": "correlated"},
          "actual_release_offset_ms": {"type": "integer", "minimum": 0, "x-provenance": "derived"}
        }
      },
      "x-provenance": "correlated"
    }
  }
}
